  <diagram id="auth-identity-v2" name="05 - Auth ve Identity">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Gateway, Keycloak ve Identity Veri Akislari" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="880" height="40" as="geometry" /></mxCell>
        <mxCell id="note" value="Mavi: REST  |  Yesil: Keycloak veya gRPC  |  Kirmizi: mevcut guvenlik riski" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="75" width="800" height="35" as="geometry" /></mxCell>
        <mxCell id="client" value="Istemci&#xa;Web / Mobil" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="60" height="80" as="geometry" /></mxCell>
        <mxCell id="gateway" value="Gateway :8095&#xa;JWT signature + issuer validation&#xa;RBAC + route&#xa;X-User-* enrichment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="345" width="210" height="115" as="geometry" /></mxCell>
        <mxCell id="user" value="user-service :8081&#xa;AuthController / UserAuthService&#xa;KeycloakUserService&#xa;gRPC token server :9194" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="335" width="230" height="125" as="geometry" /></mxCell>
        <mxCell id="keycloak-token" value="Keycloak banking realm&#xa;OIDC token endpoint&#xa;login + refresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="keycloak-logout" value="Keycloak banking realm&#xa;OIDC logout endpoint&#xa;refresh token invalidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="335" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="target" value="Hedef mikroservis&#xa;user / customer / money / transaction / admin&#xa;Gateway route sonrasi REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="610" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="transaction" value="transaction-service :8083&#xa;Create transaction&#xa;Authorization tokeni yeniden decode ettirir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="230" height="105" as="geometry" /></mxCell>
        <mxCell id="risk" value="MEVCUT RISKLER&#xa;1. Gelen X-User-* header'lari once strip edilmiyor.&#xa;2. Command/query internal API'leri Gateway'de route edilmis.&#xa;3. Login request loglari credential sizintisi uretebilir.&#xa;4. Password grant modern public-client hedefi degildir." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1220" y="285" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="target-note" value="HEDEF&#xa;Header strip + signed internal context&#xa;mTLS/workload identity&#xa;Authorization Code + PKCE / FAPI&#xa;Internal servisleri public route'tan cikar&#xa;Secret ve PII log redaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1220" y="525" width="300" height="150" as="geometry" /></mxCell>
        <mxCell id="login-label" value="LOGIN / REFRESH / LOGOUT" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;align=left;fontColor=#6f4c7f;" vertex="1" parent="1"><mxGeometry x="500" y="135" width="270" height="30" as="geometry" /></mxCell>
        <mxCell id="request-label" value="AUTHENTICATED BUSINESS REQUEST" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;align=left;fontColor=#6f4c7f;" vertex="1" parent="1"><mxGeometry x="375" y="545" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="e1" value="POST /api/user-service/v1/auth/login|refresh|logout&#xa;Public auth route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="client" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="REST route :8081" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="gateway" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="form-urlencoded&#xa;password veya refresh_token grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="user" target="keycloak-token"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="access token + refresh token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="user" target="keycloak-token"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="285" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="refresh token -> logout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="user" target="keycloak-logout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="Bearer JWT&#xa;issuer + signature + role validation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="client" target="gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="650" /><mxPoint x="315" y="650" /></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="REST + X-User-KeycloakUUID/email/name/surname/roles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="gateway" target="target"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Transaction REST route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="target" target="transaction"><mxGeometry relative="1" as="geometry" /></mxCell>
