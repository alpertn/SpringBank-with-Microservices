        <mxCell id="e10" value="Kafka publish after gRPC success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="user" target="user-created"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="Kafka consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="user-created" target="money"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="JPA hesap ve IBAN write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="money" target="money-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
