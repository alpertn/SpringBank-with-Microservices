  <diagram id="transaction-v1" name="03 - Transaction ve Saga">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Transaction: Deposit, Withdraw, Transfer ve Saga Geri Alma" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="295" y="20" width="1010" height="40" as="geometry" /></mxCell>
        <mxCell id="legend" value="Mavi: HTTPS/REST. Yesil: gRPC. Turuncu kesikli: Kafka topic. Kirmizi kesikli: failure veya compensation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="840" height="35" as="geometry" /></mxCell>
        <mxCell id="client" value="Istemci&#xa;POST /api/transaction-service/v1/transactions/create" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="315" width="70" height="95" as="geometry" /></mxCell>
        <mxCell id="gateway" value="Gateway&#xa;JWT + X-User-* headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="310" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="transaction" value="transaction-service&#xa;Token decode, event UUID&#xa;TransactionEntity = CREATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="transaction-pg" value="PostgreSQL&#xa;banking_transactions&#xa;TransactionEntity + SagaEvents" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="525" width="190" height="65" as="geometry" /></mxCell>
        <mxCell id="money-block" value="money-service&#xa;TRANSFER: bakiye kontrolu&#xa;available -> blocked balance&#xa;DEPOSIT/WITHDRAW: dogrudan uygula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="295" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="money-pg" value="PostgreSQL&#xa;banking_money&#xa;Hesap, available, blocked balance" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="665" y="525" width="180" height="65" as="geometry" /></mxCell>
        <mxCell id="user" value="user-service&#xa;Gonderen ve alici&#xa;Keycloak dogrulamasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="285" width="175" height="90" as="geometry" /></mxCell>
        <mxCell id="fraud" value="fraud-service&#xa;Event idempotency&#xa;FRAUD_REVIEW&#xa;fraud.checked yayinlar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="280" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="money-execute" value="money-service&#xa;TRANSFER execute&#xa;blocked withdraw + receiver deposit&#xa;COMPLETED veya FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="485" width="180" height="105" as="geometry" /></mxCell>
        <mxCell id="failure" value="Herhangi bir validation, bakiye veya execution hatasi&#xa;Kafka: transaction.failed.v1&#xa;transaction-service ilgili kaydi FAILED yapar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="670" width="255" height="75" as="geometry" /></mxCell>
        <mxCell id="saga-start" value="Cancel / Reverse&#xa;COMPLETED islem icin&#xa;SagaEvents = CREATED&#xa;transaction.saga.created.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="775" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="saga-money" value="money-service SagaService&#xa;TRANSFER: alicidan cek, gonderene yatir&#xa;DEPOSIT/WITHDRAW: ters hareket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="775" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="saga-result" value="transaction-service&#xa;SagaEvents status&#xa;COMPLETED veya ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="780" width="190" height="85" as="geometry" /></mxCell>
        <mxCell id="e1" value="HTTPS / REST + Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="client" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="HTTP internal route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="gateway" target="transaction"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="gRPC :9194&#xa;decode authorization token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="transaction" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="150" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="JPA save: CREATED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="transaction" target="transaction-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Kafka: transaction.created.v1&#xa;DEPOSIT / WITHDRAW / TRANSFER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="transaction" target="money-block"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="JPA balance write / block funds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="money-block" target="money-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Kafka: transaction.money-blocked.v1&#xa;Transaction state = BLOCK_MONEY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="money-block" target="transaction"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="455" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="Kafka: transaction.user-validation.request.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="money-block" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Kafka: transaction.user-validation.success.v1&#xa;sender/receiver fields completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="user" target="fraud"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="Kafka: transaction.fraud.checked.v1&#xa;status = FRAUD_REVIEW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="fraud" target="money-execute"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="Kafka: transaction.completed.v1&#xa;Transaction state = COMPLETED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="money-execute" target="transaction"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="630" /><mxPoint x="465" y="630" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="Kafka: transaction.failed.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="failure" target="transaction"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="JPA create SagaEvents + Kafka publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="transaction" target="saga-start"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="Kafka: transaction.saga.created.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="saga-start" target="saga-money"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="Kafka: saga.money.completed.v1&#xa;veya saga.money.failed.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="saga-money" target="saga-result"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cqrs-admin-v1" name="04 - CQRS ve Admin">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CQRS Projection ve Admin Denetim Akislari" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="20" width="870" height="40" as="geometry" /></mxCell>
        <mxCell id="legend" value="Her satirda write-side PostgreSQL kaynagidir. Kafka projection sonrasi MongoDB read model, Elasticsearch arama katmanidir." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305" y="70" width="990" height="35" as="geometry" /></mxCell>
        <mxCell id="customer-label" value="CUSTOMER CQRS" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6f4c7f;" vertex="1" parent="1"><mxGeometry x="55" y="175" width="220" height="30" as="geometry" /></mxCell>
        <mxCell id="customer-facade" value="customer-service&#xa;REST facade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="155" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="customer-command" value="customer-service-command&#xa;gRPC :9200&#xa;PostgreSQL write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="145" width="195" height="85" as="geometry" /></mxCell>
        <mxCell id="customer-pg" value="banking_customer_command&#xa;Customer source of truth" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="145" width="185" height="70" as="geometry" /></mxCell>
        <mxCell id="customer-query" value="customer-service-query&#xa;Kafka consumer&#xa;gRPC :9201" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="145" width="185" height="85" as="geometry" /></mxCell>
        <mxCell id="customer-read" value="MongoDB: banking_customer_query&#xa;Elasticsearch: customer-profiles" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1295" y="145" width="215" height="70" as="geometry" /></mxCell>
        <mxCell id="money-label" value="MONEY CQRS (AYRI API)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6f4c7f;" vertex="1" parent="1"><mxGeometry x="55" y="395" width="260" height="30" as="geometry" /></mxCell>
        <mxCell id="money-gateway" value="Gateway&#xa;REST command/query routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="375" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="money-command" value="money-service-command&#xa;create, deposit, withdraw,&#xa;block-money, transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="365" width="195" height="90" as="geometry" /></mxCell>
        <mxCell id="money-cqrs-pg" value="Money command PostgreSQL&#xa;CQRS write-side" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="375" width="185" height="65" as="geometry" /></mxCell>
        <mxCell id="money-query" value="money-service-query&#xa;Kafka consumer&#xa;REST query API + gRPC :9193" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="365" width="195" height="90" as="geometry" /></mxCell>
        <mxCell id="money-read" value="MongoDB: banking_money_query&#xa;Elasticsearch: money-accounts" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1295" y="375" width="215" height="65" as="geometry" /></mxCell>
        <mxCell id="money-note" value="Bu CQRS akisi mevcut operasyonel money-service transaction zincirinden ayri bir hesap API'sidir." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="455" y="490" width="765" height="35" as="geometry" /></mxCell>
        <mxCell id="admin-label" value="ADMIN HISTORY CQRS" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6f4c7f;" vertex="1" parent="1"><mxGeometry x="55" y="655" width="240" height="30" as="geometry" /></mxCell>
        <mxCell id="admin" value="admin-service&#xa;ADMIN REST endpoints&#xa;requestId + admin context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="630" width="175" height="85" as="geometry" /></mxCell>
        <mxCell id="admin-command" value="admin-service-command&#xa;gRPC :9197&#xa;Kafka command consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="195" height="85" as="geometry" /></mxCell>
        <mxCell id="admin-pg" value="banking_admin_command&#xa;AdminHistoryRecord write-side" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="640" width="185" height="65" as="geometry" /></mxCell>
        <mxCell id="admin-query" value="admin-service-query&#xa;gRPC :9198&#xa;History read model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="630" width="185" height="85" as="geometry" /></mxCell>
        <mxCell id="admin-read" value="MongoDB: banking_admin_query&#xa;Elasticsearch: admin-query-history" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1295" y="640" width="215" height="65" as="geometry" /></mxCell>
        <mxCell id="admin-async" value="Asenkron audit: admin-service -> Kafka admin.history.command.v1 -> admin-service-command.&#xa;Senkron audit: admin-service -> gRPC :9197 -> command.&#xa;Tum history read islemleri: admin-service -> gRPC :9198 -> query." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="770" width="735" height="55" as="geometry" /></mxCell>
        <mxCell id="e1" value="gRPC command :9200" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="customer-facade" target="customer-command"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="JPA write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="customer-command" target="customer-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Kafka: customer.projection-sync.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="customer-command" target="customer-query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Mongo save + Elasticsearch upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="customer-query" target="customer-read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="gRPC query :9201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="customer-facade" target="customer-query"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="250" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="HTTPS / REST command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="money-gateway" target="money-command"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="JPA write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="money-command" target="money-cqrs-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Kafka: money.projection-sync.v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="money-command" target="money-query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Mongo save + Elasticsearch upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="money-query" target="money-read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="HTTPS / REST query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;endArrow=block;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="money-gateway" target="money-query"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="535" /></Array></mxGeometry></mxCell>
